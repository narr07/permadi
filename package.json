		"@nuxt/a11y": "^1.0.0-alpha.1",
		"@nuxt/eslint": "^1.17.0",
		"@nuxt/fonts": "^1.0.1",
		"@nuxtjs/color-mode": "^4.0.1",
		"@resvg/resvg-wasm": "^2.6.2",
		"@types/better-sqlite3": "^9.6.0",
		"@unlighthouse/cli": "^0.19.1",
		"@unocss/eslint-plugin": "^66.11.0",
		"@unocss/nuxt": "^66.11.0",
		"@unocss/preset-icons": "^66.11.0",
