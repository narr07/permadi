		"@nuxthub/core": "^0.10.8",
		"@nuxtjs/i18n": "^10.6.0",
		"@nuxtjs/mcp-toolkit": "^0.24.2",
		"@nuxtjs/seo": "^6.0.1",
		"@pinia/nuxt": "^1.0.3",
		"@resvg/resvg-js": "^2.6.2",
		"@sentry/nuxt": "11.7.0",
		"@stefanobartoletti/nuxt-social-share": "3.2.1",
		"beautiful-mermaid": "^1.1.3",
		"better-sqlite3": "^13.0.3",
		"comark": "0.7.0",
		"drizzle-orm": "^0.45.4",
		"motion-v": "^2.8.0",
		"nuxt": "^4.6.2",
		"nuxt-llms": "^0.2.0",
		"nuxt-studio": "^1.8.0",
		"pinia": "^4.1.0",
		"rangi": "2.2.0",
