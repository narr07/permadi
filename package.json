{
	"name": "permadi",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.3.14",
	"scripts": {
		"build": "node scripts/generate-vscode-icons.mjs && node --max-old-space-size=4096 node_modules/nuxt/bin/nuxt.mjs build",
		"icons:vscode": "node scripts/generate-vscode-icons.mjs",
		"deploy": "bun run build && wrangler deploy",
		"dev": "node --max-old-space-size=4096 node_modules/nuxt/bin/nuxt.mjs dev",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"prepare": "nuxt prepare",
		"convert:webp": "bun scripts/convert-webp.ts",
		"research": "bun scripts/research-trends.ts",
		"auto:blog": "node scripts/auto-generate.mjs",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"audit": "unlighthouse-ci --site https://permadi.dev",
		"audit:local": "unlighthouse-ci --site http://localhost:3000 --output-path ./reports/unlighthouse-local"
	},
	"dependencies": {
		"@comark/vue": "0.7.0",
		"@modelcontextprotocol/client": "^2.3.1",
		"@modelcontextprotocol/server": "^2.3.1",
